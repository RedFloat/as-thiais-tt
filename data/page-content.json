  "pages": {
    "le_club": {
      "label": "Le Club",
      "file": "le_club.html",
      "body": "  <!-- ==========================================\n     HERO LE CLUB\n     ========================================== -->\n  <section class=\"page-hero\">\n    <div class=\"container\">\n      <span class=\"badge-gold\">Depuis 1995</span>\n      <h1>Le Club</h1>\n      <p>\n        L'Association Sportive Thiais Tennis de Table, association loi 1901, a pour activité la pratique\n        du tennis de table à Thiais depuis près de 30 ans.\n      </p>\n    </div>\n  </section>\n\n  <!-- ==========================================\n     CONTENU PRINCIPAL\n     ========================================== -->\n  <section class=\"page-content\">\n    <div class=\"container\">\n\n      <!-- Histoire + Agréments -->\n      <div class=\"club-history\">\n        <div class=\"panel-card\">\n          <h2><i class=\"fa-solid fa-book-open\"></i> Notre histoire</h2>\n          <p>\n            L'Association Sportive Thiais Tennis de Table, association loi 1901, a été créée le\n            <strong>7 novembre 1995</strong>, présidée à sa création par <strong>Jacques Berthaud</strong>.\n          </p>\n          <p>\n            M. Berthaud Jacques en a été l'emblématique président jusqu'en 2008, poste qu'il a quitté\n            pour des raisons de santé. Le club lui doit son développement et ses meilleures années.\n          </p>\n          <p>\n            Le club a pour principal soutien la Ville de Thiais, qui l'accompagne depuis de nombreuses\n            années, notamment pendant la période où il a connu son plus haut niveau, en Nationale 1.\n          </p>\n        </div>\n\n        <div class=\"panel-card\">\n          <h2><i class=\"fa-solid fa-stamp\"></i> Agréments</h2>\n          <div class=\"agreements-box\">\n            <div class=\"agreement-item\">\n              <i class=\"fa-solid fa-landmark\"></i>\n              <div>\n                <strong>Ministère de la Jeunesse et des Sports</strong>\n                <span>Agrément n° 94 S 487</span>\n              </div>\n            </div>\n            <div class=\"agreement-item\">\n              <i class=\"fa-solid fa-trophy\"></i>\n              <div>\n                <strong>Fédération Française de Tennis de Table</strong>\n                <span>Agrément n° 08940459</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Chiffres clés -->\n      <div class=\"stats-grid\">\n        <div class=\"stat-card\">\n          <div class=\"stat-number\">~160</div>\n          <div class=\"stat-label\">Adhérents, dont <span class=\"accent\">18%</span> de féminines</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-number\">10</div>\n          <div class=\"stat-label\">Équipes en championnat par équipe Messieurs</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-number\">1</div>\n          <div class=\"stat-label\">Équipe en championnat par équipe Dames</div>\n        </div>\n        <div class=\"stat-card\">\n          <div class=\"stat-icon-circle\"><i class=\"fa-solid fa-child-reaching\"></i></div>\n          <div class=\"stat-label\">Équipes <strong>Jeunes</strong> & Championnat de <strong>Paris</strong></div>\n        </div>\n      </div>\n\n      <!-- Infrastructure + Soutien -->\n      <div class=\"infra-support-grid\">\n        <div class=\"panel-card\">\n          <h2><i class=\"fa-solid fa-building-columns\"></i> Nos installations</h2>\n          <ul class=\"infra-list\">\n            <li><i class=\"fa-solid fa-location-dot\"></i> Siège au <strong>Palais Omnisports de Thiais</strong></li>\n            <li><i class=\"fa-solid fa-square-parking\"></i> Parking de plus de <strong>100 places</strong></li>\n            <li><i class=\"fa-solid fa-table-tennis-paddle-ball\"></i> Salle spécifique de <strong>16 tables</strong>, extensible jusqu'à <strong>20 tables</strong></li>\n          </ul>\n        </div>\n\n        <div class=\"support-panel\">\n          <span class=\"badge-gold\">Partenaire historique</span>\n          <h2><i class=\"fa-solid fa-handshake\"></i> Le soutien de la Ville de Thiais</h2>\n          <p>\n            Le club a pour principal soutien la Ville de Thiais, qui l'accompagne depuis de nombreuses\n            années, notamment durant la période où il a connu son plus haut niveau sportif, en Nationale 1.\n          </p>\n        </div>\n      </div>\n\n      <!-- Hommage -->\n      <div class=\"tribute-panel\">\n        <h2 style=\"color:var(--color-navy); font-size:1.3rem; margin-bottom:1.5rem; display:flex; align-items:center; gap:0.6rem;\">\n          <i class=\"fa-solid fa-award\" style=\"color:var(--color-gold);\"></i> Hommage\n        </h2>\n\n        <div class=\"tribute-founder\">\n          <div class=\"tribute-founder-avatar\">JB</div>\n          <div>\n            <span class=\"tribute-role\">Président fondateur (1995 - 2008)</span>\n            <h3>Jacques Berthaud</h3>\n            <p>\n              Président emblématique du club jusqu'en 2008, poste qu'il a quitté pour des raisons de santé.\n              Le club lui doit son développement et ses meilleures années.\n            </p>\n          </div>\n        </div>\n\n        <p style=\"color:var(--color-text-muted); font-size:0.9rem; margin-bottom:1.2rem;\">\n          Hommage à quelques joueurs qui ont fait du club ce qu'il est aujourd'hui :\n        </p>\n\n        <div class=\"tribute-players-grid\">\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">AD</div>\n            <div>\n              <strong>Ananou Dodji</strong>\n              <span>Joueur et entraîneur, parmi les meilleurs joueurs en France</span>\n            </div>\n          </div>\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">VF</div>\n            <div>\n              <strong>Valensi Franck</strong>\n              <span>Joueur entraîneur, de la génération J.P. Gatien</span>\n            </div>\n          </div>\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">DG</div>\n            <div>\n              <strong>Djondo Gaetan</strong>\n              <span>Joueur historique du club</span>\n            </div>\n          </div>\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">KY</div>\n            <div>\n              <strong>Kidjo Yves</strong>\n              <span>Joueur historique du club</span>\n            </div>\n          </div>\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">DL</div>\n            <div>\n              <strong>Dan LY</strong>\n              <span>Joueur historique du club</span>\n            </div>\n          </div>\n          <div class=\"tribute-player-card\">\n            <div class=\"tribute-player-avatar\">AY</div>\n            <div>\n              <strong>Amaizo Yves</strong>\n              <span>Joueur historique du club</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Infos pratiques -->\n      <div class=\"practical-panel\">\n        <div class=\"practical-item\">\n          <i class=\"fa-solid fa-calendar-week\"></i>\n          <div>\n            <strong>Ouverture du club</strong>\n            <p>Le club accueille ses adhérents du lundi au dimanche — consultez les <a href=\"./entrainements.html\">horaires d'accès</a> sur le site.</p>\n          </div>\n        </div>\n        <div class=\"practical-item\">\n          <i class=\"fa-solid fa-person-running\"></i>\n          <div>\n            <strong>Entraînements</strong>\n            <p>Séances d'entraînement du lundi au jeudi — consultez la rubrique <a href=\"./entrainements.html\">Entraînements</a>.</p>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n"
    },
    "entrainements": {
      "label": "Entraînements",
      "file": "entrainements.html",
      "body": "  <!-- ==========================================\n     HERO ENTRAINEMENTS\n     ========================================== -->\n  <section class=\"page-hero\">\n    <div class=\"container\">\n      <span class=\"badge-gold\" data-season-badge>Saison 2025-2026</span>\n      <h1>Entraînements</h1>\n      <p>\n        Retrouvez toutes les informations pratiques concernant le lieu, le planning et les créneaux\n        d'entraînement du club pour la saison.\n      </p>\n    </div>\n  </section>\n\n  <!-- ==========================================\n     CONTENU PRINCIPAL\n     ========================================== -->\n  <section class=\"page-content\">\n    <div class=\"container\">\n\n      <!-- Lieu -->\n      <div class=\"info-strip\">\n        <div class=\"info-strip-item\">\n          <i class=\"fa-solid fa-location-dot\"></i>\n          <div>\n            <strong>Lieu</strong>\n            <span>Palais Omnisports de Thiais, salle spécifique</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Planning + Créneaux retraités -->\n      <div class=\"planning-grid\">\n        <div class=\"panel-card planning-panel\">\n          <h2><i class=\"fa-solid fa-calendar-days\"></i> Planning de la saison</h2>\n          <div class=\"planning-list\">\n            <div class=\"planning-list-item\">\n              <i class=\"fa-solid fa-play\"></i>\n              <div>\n                <strong>Rentrée des entraînements</strong>\n                <span>Lundi 8 septembre 2025</span>\n              </div>\n            </div>\n            <div class=\"planning-list-item\">\n              <i class=\"fa-solid fa-calendar-check\"></i>\n              <div>\n                <strong>Sauf le samedi</strong>\n                <span>Début le samedi 20 septembre 2026</span>\n              </div>\n            </div>\n          </div>\n          <div class=\"holiday-note\">\n            <i class=\"fa-solid fa-circle-info\"></i>\n            Pas d'entraînement pendant les congés scolaires.\n          </div>\n        </div>\n\n        <div class=\"retraites-panel\">\n          <span class=\"badge-gold\">Créneau dédié</span>\n          <h2><i class=\"fa-solid fa-user-group\"></i> Créneaux retraités</h2>\n          <p>Un créneau spécialement dédié aux retraités est proposé chaque semaine.</p>\n          <div class=\"retraites-slots\">\n            <span class=\"retraites-slot\"><i class=\"fa-solid fa-clock\"></i> Lundi 9h - 12h</span>\n            <span class=\"retraites-slot\"><i class=\"fa-solid fa-clock\"></i> Vendredi 9h - 12h</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Créneaux d'entraînement (image cliquable -> PDF) -->\n      <div class=\"schedule-panel\">\n        <h2><i class=\"fa-solid fa-table-list\"></i> Créneaux d'entraînement</h2>\n        <p class=\"schedule-panel-intro\">\n          Consultez le détail de tous les créneaux d'entraînement par équipe et par catégorie. Cliquez sur\n          l'aperçu ci-dessous pour ouvrir le planning complet au format PDF.\n        </p>\n        <a href=\"./docs/entrainements-horaires.pdf\" target=\"_blank\" rel=\"noopener\" class=\"schedule-preview-link\">\n          <img src=\"./imgs/apercu-entrainement.png\" alt=\"Aperçu des créneaux d'entraînement — cliquer pour ouvrir le PDF complet\">\n          <div class=\"schedule-preview-overlay\">\n            <span><i class=\"fa-solid fa-file-pdf\"></i> Ouvrir le planning complet (PDF)</span>\n          </div>\n        </a>\n      </div>\n\n    </div>\n  </section>\n"
    },
    "inscription": {
      "label": "Inscription",
      "file": "inscription.html",
      "body": "  <!-- ==========================================\n     HERO INSCRIPTION\n     ========================================== -->\n  <section class=\"page-hero\">\n    <div class=\"container\">\n      <span class=\"badge-gold\" data-season-badge=\"\">Saison 2026-2027</span>\n      <h1>Inscriptions</h1>\n      <p>\n        Une nouvelle saison commence, avec les premiers matchs mi-septembre pour les équipes évoluant en National\n        et fin septembre pour toutes les autres. Pensez à vous inscrire dès que possible, surtout si vous\n        pratiquez la compétition !\n      </p>\n    </div>\n  </section>\n\n  <!-- ==========================================\n     CONTENU PRINCIPAL\n     ========================================== -->\n  <section class=\"page-content\">\n    <div class=\"container\">\n\n      <!-- CTA Inscription en ligne -->\n      <div class=\"cta-panel\">\n        <span class=\"badge-gold\">Nouveau</span>\n        <h2>Inscrivez-vous directement en ligne</h2>\n        <p>\n          Il y a du nouveau pour vous inscrire cette saison : vous pouvez désormais le faire directement sur\n          internet, en suivant le lien ci-dessous.\n        </p>\n        <a href=\"https://as-thiais-tt.assoconnect.com/collect/description/617278-o-inscription-saison-2026-2027\" class=\"btn-primary btn-large\">\n          <i class=\"fa-solid fa-arrow-up-right-from-square\"></i> Accéder au site d'inscription\n        </a>\n        <div class=\"cta-subnote\">\n          <i class=\"fa-solid fa-circle-info\"></i>\n          Vous étiez licencié(e) à Thiais la saison dernière ? Retrouvez votre profil directement sur le site\n          en indiquant simplement votre nom, prénom et adresse mail. Merci de bien vouloir vérifier les\n          différentes informations qui y sont indiquées.\n        </div>\n      </div>\n\n      <!-- Documents santé + Cotisation -->\n      <div class=\"content-grid-2\">\n\n        <!-- Colonne gauche : documents santé -->\n        <div class=\"panel-card\">\n          <h2><i class=\"fa-solid fa-notes-medical\"></i> Document santé à joindre</h2>\n          <div class=\"health-doc-list\">\n\n            <div class=\"health-doc-item\">\n              <div class=\"health-doc-icon\">-18</div>\n              <div>\n                <strong>Moins de 18 ans</strong>\n                <p>Questionnaire de santé, disponible <a href=\"#LIEN_QUESTIONNAIRE_SANTE_MINEURS_ICI\">ici</a>.</p>\n              </div>\n            </div>\n\n            <div class=\"health-doc-item\">\n              <div class=\"health-doc-icon\">18+</div>\n              <div>\n                <strong>18 ans et plus</strong>\n                <p>Le Parcours Prévention Santé (PPS) est à valider.</p>\n              </div>\n            </div>\n\n            <div class=\"health-doc-item\">\n              <div class=\"health-doc-icon\"><i class=\"fa-solid fa-calendar-check\"></i></div>\n              <div style=\"width:100%;\">\n                <strong>Sauf années de naissance spécifiques</strong>\n                <p>Certificat médical obligatoire (avec la mention « en compétition » le cas échéant) à la place du PPS, pour les personnes nées en :</p>\n                <div class=\"birth-years-box\">\n                  <div class=\"years-grid\">\n                    <span class=\"year-chip\">1931</span>\n                    <span class=\"year-chip\">1936</span>\n                    <span class=\"year-chip\">1941</span>\n                    <span class=\"year-chip\">1946</span>\n                    <span class=\"year-chip\">1951</span>\n                    <span class=\"year-chip\">1956</span>\n                    <span class=\"year-chip\">1961</span>\n                    <span class=\"year-chip\">1966</span>\n                    <span class=\"year-chip\">1971</span>\n                    <span class=\"year-chip\">1976</span>\n                    <span class=\"year-chip\">1981</span>\n                    <span class=\"year-chip\">1986</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n          <div class=\"certif-note\">\n            <i class=\"fa-solid fa-circle-info\"></i>\n            Dans tous les cas, le certificat médical peut remplacer le PPS.\n          </div>\n\n          <div class=\"tuto-link-box\">\n            <i class=\"fa-solid fa-circle-play\"></i>\n            <span>Besoin d'aide pour remplir votre PPS ? Consultez notre <a href=\"https://sucy-ping.fr/tutoriel-pps\" target=\"_blank\" rel=\"noopener\">tutoriel PPS</a>.</span>\n          </div>\n        </div>\n\n        <!-- Colonne droite : cotisation + options du site -->\n        <div class=\"panel-card\">\n          <h2><i class=\"fa-solid fa-euro-sign\"></i> Cotisation &amp; validation</h2>\n          <div class=\"payment-panel\">\n            <div class=\"payment-step\">\n              <div class=\"payment-step-num\">1</div>\n              <p><strong>Réglez votre cotisation</strong>Votre licence ne sera validée qu'une fois le paiement de la cotisation transmis.</p>\n            </div>\n            <div class=\"payment-step\">\n              <div class=\"payment-step-num\">2</div>\n              <p><strong>Joignez le justificatif</strong>Merci de joindre une copie de votre adhésion / preuve de paiement lors de votre inscription.</p>\n            </div>\n            <div class=\"payment-step\">\n              <div class=\"payment-step-num\">3</div>\n              <p><strong>Vérifiez vos informations</strong>Prenez un moment pour contrôler les informations affichées sur votre profil.</p>\n            </div>\n          </div>\n        </div>\n\n      </div>\n\n      <!-- Aide / Questions -->\n      <div class=\"help-panel\">\n        <div class=\"help-panel-text\">\n          <h2><i class=\"fa-solid fa-comments\"></i> Une question ?</h2>\n          <p>N'hésitez pas à revenir vers les membres du comité directeur ou les entraîneurs, nous nous ferons un plaisir de vous répondre.</p>\n        </div>\n        <a href=\"#contact\" class=\"btn-primary\">\n          <i class=\"fa-solid fa-paper-plane\"></i> Nous contacter\n        </a>\n      </div>\n\n      <!-- Permanences -->\n      <div class=\"permanences-panel\">\n        <h2><i class=\"fa-solid fa-people-group\"></i> Permanences d'inscription</h2>\n        <p class=\"permanences-intro\">\n          Pour vous aider à finaliser votre inscription, nous tiendrons des permanences à la salle aux dates suivantes, de 18h à 20h30 :\n        </p>\n        <div class=\"permanences-grid\">\n          <div class=\"permanence-day\">\n            <div class=\"day-label\">Lundi</div>\n            <div class=\"day-dates\">8 et 15 septembre</div>\n            <div class=\"day-time\"><i class=\"fa-solid fa-clock\"></i> 18h - 20h30</div>\n          </div>\n          <div class=\"permanence-day\">\n            <div class=\"day-label\">Mardi</div>\n            <div class=\"day-dates\">9 et 16 septembre</div>\n            <div class=\"day-time\"><i class=\"fa-solid fa-clock\"></i> 18h - 20h30</div>\n          </div>\n          <div class=\"permanence-day\">\n            <div class=\"day-label\">Mercredi</div>\n            <div class=\"day-dates\">10 et 17 septembre</div>\n            <div class=\"day-time\"><i class=\"fa-solid fa-clock\"></i> 18h - 20h30</div>\n          </div>\n        </div>\n        <div class=\"permanence-location\">\n          <i class=\"fa-solid fa-location-dot\" style=\"color:var(--color-gold);\"></i>\n          Palais omnisports de Thiais — Place Vincent Van Gogh, 94320 Thiais\n        </div>\n      </div>\n\n    </div>\n  </section>\n"
    },
    "reglement_interieur": {
      "label": "Règlement Intérieur",
      "file": "reglement_interieur.html",
      "body": "  <!-- ==========================================\n     HERO REGLEMENT INTERIEUR\n     ========================================== -->\n  <section class=\"page-hero\">\n    <div class=\"container\">\n      <span class=\"badge-gold\" data-season-badge>Saison 2025/2026</span>\n      <h1>Règlement Intérieur</h1>\n      <p>Cadre de vie, principes déontologiques et fonctionnement de l'association.</p>\n    </div>\n  </section>\n\n  <!-- ==========================================\n     CONTENU PRINCIPAL : REGLEMENT INTERIEUR\n     ========================================== -->\n  <main class=\"page-content\">\n    <div class=\"container\">\n      <div class=\"reglement-card\">\n        \n        <div class=\"reglement-content\">\n          <p>\n            <strong>REGLEMENT INTERIEUR 2025/2026</strong><br>\n            Ce règlement intérieur a pour objet de préciser les statuts de l’Association Sportive Thiais Tennis de Table (AS THIAIS TT), sise à Thiais. Il y est adjoint la charte régionale d’éthique et de déontologie du sport.\n          </p>\n          <p>\n            Ces documents sont affichés dans la salle de tennis de table du Palais Omnisports de Thiais et disponibles sur le site internet du club.\n          </p>\n        </div>\n\n        <div class=\"reglement-actions\">\n          <a href=\"./docs/reglement_interieur.pdf\" target=\"_blank\" class=\"btn-download-pdf\">\n            <i class=\"fa-solid fa-file-pdf\"></i> Consulter le règlement intérieur (PDF)\n          </a>\n        </div>\n\n      </div>\n    </div>\n  </main>\n\n  <!-- ==========================================\n     FOOTER\n     ========================================== -->\n"
    },
    "calendrier": {
      "label": "Calendrier (texte d'intro uniquement)",
      "file": "calendrier.html",
      "body": "<p>\n            Vous souhaitez consulter ou conserver le planning complet hors-ligne ? Téléchargez dès maintenant le calendrier officiel de la saison :\n          </p>\n          <div>\n            <a href=\"/public/9075/upload/files/2025-2026%20-%20Calendrier%20des%20manifestations1.pdf\" target=\"_blank\" class=\"btn-download\">\n              <i class=\"fa-solid fa-file-arrow-down\"></i> Télécharger le calendrier officiel (PDF)\n            </a>\n          </div>\n          <p>\n            Pour toute question relative aux rencontres ou aux convocations, rapprochez-vous de votre entraîneur ou écrivez-nous directement via la rubrique <a href=\"#contact\">Contact</a>.\n          </p>\n"
    }
  }
}