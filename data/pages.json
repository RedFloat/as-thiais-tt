m;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    border-top: 1px solid rgba(255, 255, 255, 0.15);\n    padding-top: 12px;\n  }\n\n  .astt-contact-info a {\n    color: rgba(255, 255, 255, 0.85);\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  .astt-contact-info a:hover {\n    color: var(--astt-accent-gold);\n  }\n\n  .astt-cta-container {\n    margin-top: 50px;\n  }\n\n  /* Forçage explicite de la couleur pour surpasser les styles globaux du site */\n  .astt-org-container a.astt-btn-contact,\n  .astt-org-container a.astt-btn-contact:visited {\n    display: inline-block;\n    background: var(--astt-bg-dark) !important;\n    color: var(--astt-white) !important;\n    border: 2px solid var(--astt-accent-gold) !important;\n    padding: 12px 28px;\n    border-radius: 25px;\n    font-weight: 600;\n    text-decoration: none !important;\n    transition: all 0.3s ease;\n  }\n\n  .astt-org-container a.astt-btn-contact:hover,\n  .astt-org-container a.astt-btn-contact:active {\n    background: var(--astt-accent-gold) !important;\n    color: var(--astt-bg-dark) !important;\n    box-shadow: 0 4px 15px rgba(210, 169, 91, 0.4);\n  }\n</style>\n\n<div class=\"astt-org-container\">\n  <div class=\"astt-org-wrapper\">\n    <h2 class=\"astt-org-title\">Organigramme du Bureau</h2>\n\n    <div class=\"astt-org-grid\">\n      <!-- Président -->\n      <div class=\"astt-org-row\">\n        <div class=\"astt-card\">\n          <div class=\"astt-role\">Président</div>\n          <div class=\"astt-name\">Pierre Mathieu Germain</div>\n          <div class=\"astt-contact-info\">\n            <a href=\"mailto:germain.pierremathieu@gmail.com\">germain.pierremathieu@gmail.com</a>\n            <a href=\"tel:0666482524\">06 66 48 25 24</a>\n          </div>\n        </div>\n      </div>\n\n      <!-- Autres membres -->\n      <div class=\"astt-org-row\">\n        <div class=\"astt-card\">\n          <div class=\"astt-role\">Vice-Président</div>\n         