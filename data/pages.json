    {
      "id": "organigramme",
      "title": "Organigramme",
      "slug": "organigramme",
      "body": "<style>\n  :root {\n    --orga-bg-dark: #022C43;\n    --orga-accent-gold: #D2A95B;\n    --orga-white: #ffffff;\n    --orga-text-muted: rgba(255, 255, 255, 0.7);\n    --orga-card-bg: rgba(255, 255, 255, 0.05);\n  }\n\n  body {\n    background-color: var(--orga-bg-dark);\n    color: var(--orga-white);\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n    margin: 0;\n    padding: 40px 20px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n    box-sizing: border-box;\n  }\n\n  .org-container {\n    max-width: 1000px;\n    width: 100%;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .org-title {\n    font-size: 2.2rem;\n    color: var(--orga-accent-gold);\n    margin-bottom: 40px;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    border-bottom: 2px solid var(--orga-accent-gold);\n    display: inline-block;\n    padding-bottom: 10px;\n  }\n\n  .org-grid {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 30px;\n    position: relative;\n  }\n\n  .org-row {\n    display: flex;\n    justify-content: center;\n    gap: 24px;\n    flex-wrap: wrap;\n    width: 100%;\n  }\n\n  .card {\n    background: var(--orga-card-bg);\n    border: 1px solid rgba(210, 169, 91, 0.3);\n    border-top: 4px solid var(--orga-accent-gold);\n    border-radius: 8px;\n    padding: 24px;\n    width: 280px;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n    backdrop-filter: blur(5px);\n    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;\n  }\n\n  .card:hover {\n    transform: translateY(-5px);\n    border-color: var(--orga-accent-gold);\n    box-shadow: 0 15px 35px rgba(210, 169, 91, 0.15);\n  }\n\n  .role {\n    color: var(--orga-accent-gold);\n    font-size: 0.9rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    margin-bottom: 8px;\n  }\n\n  .name {\n    font-size: 1.25rem;\n    font-weight: 600;\n    margin-bottom: 16px;\n    color: var(--orga-white);\n  }\n\n  .contact-info {\n    font-size: 0.9rem;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    border-top: 1px solid rgba(255, 255, 255, 0.1);\n    padding-top: 12px;\n  }\n\n  .contact-info a {\n    color: var(--orga-text-muted);\n    text-decoration: none;\n    transition: color 0.2s ease;\n  }\n\n  .contact-info a:hover {\n    color: var(--orga-accent-gold);\n  }\n\n  .cta-container {\n    margin-top: 50px;\n  }\n\n  .btn-contact {\n    display: inline-block;\n    background: transparent;\n    color: var(--orga-accent-gold);\n    border: 2px solid var(--orga-accent-gold);\n    padding: 12px 28px;\n    border-radius: 25px;\n    font-weight: 600;\n    text-decoration: none;\n    transition: all 0.3s ease;\n    cursor: pointer;\n  }\n\n  .btn-contact:hover {\n    background: var(--orga-accent-gold);\n    color: var(--orga-bg-dark);\n    box-shadow: 0 0 15px rgba(210, 169, 91, 0.4);\n  }\n</style>\n\n<div class=\"org-container\">\n  <h1 class=\"org-title\">Organigramme du Bureau</h1>\n\n  <div class=\"org-grid\">\n    <!-- Niveau 1 : Président -->\n    <div class=\"org-row\">\n      <div class=\"card\">\n        <div class=\"role\">Président</div>\n        <div class=\"name\">Pierre Mathieu Germain</div>\n        <div class=\"contact-info\">\n          <a href=\"mailto:germain.pierremathieu@gmail.com\">germain.pierremathieu@gmail.com</a>\n          <a href=\"tel:0666482524\">06 66 48 25 24</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Niveau 2 : Vice-Président, Trésorier, Secrétaire -->\n    <div class=\"org-row\">\n      <div class=\"card\">\n        <div class=\"role\">Vice-Président</div>\n        <div class=\"name\">Philippe Lewi</div>\n        <div class=\"contact-info\">\n          <a href=\"mailto:philippe.lewi@sfr.fr\">philippe.lewi@sfr.fr</a>\n          <a href=\"tel:0681612124\">06 81 61 21 24</a>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"role\">Trésorier</div>\n        <div class=\"name\">Emmanuel Montreuil</div>\n        <div class=\"contact-info\">\n          <a href=\"mailto:montreuil.emmanuel@orange.fr\">montreuil.emmanuel@orange.fr</a>\n          <a href=\"tel:0683964067\">06 83 96 40 67</a>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"role\">Secrétaire</div>\n        <div class=\"name\">Fabrice Couturas</div>\n        <div class=\"contact-info\">\n          <a href=\"mailto:fabcou@neuf.fr\">fabcou@neuf.fr</a>\n          <a href=\"tel:0682010569\">06 82 01 05 69</a>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cta-container\">\n    <a href=\"https://redfloat.github.io/as-thiais-tt/contact.html\" class=\"btn-contact\" id=\"contactBtn\">Accéder au formulaire de contact</a>\n  </div>\n</div>\n\n<script>\n  document.addEventListener('DOMContentLoaded', () => {\n    const contactBtn = document.getElementById('contactBtn');\n    if (contactBtn) {\n      contactBtn.addEventListener('click', () => {\n        window.location.href = \"https://redfloat.github.io/as-thiais-tt/contact.html\";\n      });\n    }\n\n    const cards = document.querySelectorAll('.card');\n    cards.forEach(card => {\n      card.addEventListener('mouseenter', () => {\n        card.style.transform = 'translateY(-5px) scale(1.02)';\n      });\n      card.addEventListener('mouseleave', () => {\n        card.style.transform = 'translateY(0) scale(1)';\n      });\n    });\n  });\n</script>",
      "date": "2026-09-01"
    }
  ]
}