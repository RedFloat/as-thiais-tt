      "title": "Mentions Légales",
      "slug": "mentions-legales",
      "body": "<!-- Bibliothèques Leaflet pour la carte (à inclure si ce n'est pas déjà dans votre <head>) -->\n<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\" />\n<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n\n<style>\n  /* --- STYLES DU COMPOSANT --- */\n  .contact-section {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #4a4a4a;\n    max-width: 1100px;\n    margin: 0 auto;\n    padding: 20px;\n  }\n\n  .contact-title {\n    text-align: center;\n    color: #d3d3d3;\n    font-size: 24px;\n    font-weight: bold;\n    letter-spacing: 1px;\n    margin-bottom: 40px;\n    text-transform: uppercase;\n  }\n\n  .contact-container {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 40px;\n    align-items: flex-start;\n  }\n\n  .contact-info {\n    flex: 1;\n    min-width: 300px;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .contact-info h2 {\n    font-size: 22px;\n    font-weight: bold;\n    color: #333333;\n    margin-top: 0;\n    margin-bottom: 20px;\n    text-align: center;\n    text-transform: uppercase;\n  }\n\n  .contact-info .address {\n    text-align: center;\n    font-weight: 500;\n    margin-bottom: 20px;\n    text-transform: uppercase;\n  }\n\n  .contact-info p {\n    margin: 8px 0;\n  }\n\n  .contact-info a {\n    color: #b0c4de;\n    text-decoration: underline;\n  }\n\n  .contact-info a:hover {\n    color: #7b96b8;\n  }\n\n  .map-container {\n    flex: 1;\n    min-width: 300px;\n    height: 380px;\n    border: 1px solid #ccc;\n  }\n\n  #map {\n    width: 100%;\n    height: 100%;\n  }\n</style>\n\n<!-- --- CORPS DE LA PAGE --- -->\n<section class=\"contact-section\">\n  <h1 class=\"contact-title\">NOUS CONTACTER</h1>\n\n  <div class=\"contact-container\">\n    <!-- COLONNE GAUCHE : INFORMATIONS -->\n    <div class=\"contact-info\">\n      <h2>AS THIAIS TENNIS DE TABLE</h2>\n\n      <div class=\"address\">\n        PALAIS OMNISPORTS DE THIAIS - PLACE VINCENT VAN GOGH<br>\n        94320 THIAIS\n      </div>\n\n      <p>Parking de plus de 100 places.</p>\n      \n      <p>\n        <strong>Président :</strong> Pierre Mathieu GERMAIN \n        <a href=\"mailto:germain.pierremathieu@gmail.com\">germain.pierremathieu@gmail.com</a> \n        06 66 48 25 24\n      </p>\n\n      <p>\n        <strong>Vice Président :</strong> Philippe LEWI \n        <a href=\"mailto:philippe.lewi@sfr.fr\">philippe.lewi@sfr.fr</a> \n        06 81 61 21 24\n      </p>\n\n      <p>\n        <strong>Trésorier :</strong> Emmanuel MONTREUIL \n        <a href=\"mailto:montreuil.emmanuel@orange.fr\">montreuil.emmanuel[at]orange.fr</a> \n        06 83 96 40 67\n      </p>\n\n      <p>\n        <strong>Secrétaire :</strong> Fabrice COUTURAS \n        <a href=\"mailto:fabcou@neuf.fr\">fabcou[at]neuf.fr</a> \n        06 82 01 05 69\n      </p>\n\n      <br>\n\n      <p>\n        <strong>Facebook :</strong> \n        <a href=\"#\" target=\"_blank\">thiais ping 5</a>\n      </p>\n\n      <p>\n        <strong>Instagram :</strong> \n        <a href=\"#\" target=\"_blank\">thiais_ping</a>\n      </p>\n    </div>\n\n    <!-- COLONNE DROITE : CARTE LEAFLET -->\n    <div class=\"map-container\">\n      <div id=\"map\"></div>\n    </div>\n  </div>\n</section>\n\n<!-- --- SCRIPT JS LEAFLET --- -->\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    // Coordonnées du Palais Omnisports de Thiais\n    const lat = 48.7617;\n    const lng = 2.3908;\n\n    // Initialisation de la carte\n    const map = L.map('map').setView([lat, lng], 15);\n\n    // Ajout des tuiles OpenStreetMap\n    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n      attribution: '&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors'\n    }).addTo(map);\n\n    // Ajout du marqueur\n    L.marker([lat, lng]).addTo(map)\n      .bindPopup('<b>AS Thiais Tennis de Table</b><br>Palais Omnisports de Thiais');\n  });\n</script>",
      "date": "2026-08-14"
    }
  ]
}